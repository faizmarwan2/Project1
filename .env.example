APP_NAME="Workforce Attendance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite dipakai agar tidak perlu server database terpisah.
# Buat berkasnya dulu: database/database.sqlite (kosong) lalu `php artisan migrate`.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- Variabel khusus aplikasi (dibaca App\Services\JwtService & controller) ---
JWT_SECRET=ganti-dengan-secret-panjang-dan-acak
EMAIL_DOMAIN=ethes.tech
HR_EMAIL=se@ethes.tech
HR_PASSWORD=Admin123!
