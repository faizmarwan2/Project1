APP_NAME="Workforce Attendance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL/MariaDB. Buat database kosong lebih dulu, lalu `php artisan migrate`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workforce_attendance
DB_USERNAME=root
DB_PASSWORD=

# --- Variabel khusus aplikasi (dibaca App\Services\JwtService & controller) ---
JWT_SECRET=ganti-dengan-secret-panjang-dan-acak
EMAIL_DOMAIN=ethes.tech
HR_EMAIL=se@ethes.tech
HR_PASSWORD=Admin123!
